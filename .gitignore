# Python virtual environment. About 1.3 GB of installable packages - anyone
# cloning this rebuilds it from server/requirements.txt in a few minutes.
server/.venv/
.venv/

__pycache__/
*.py[cod]

# Working backups written while editing. The history in git replaces these.
*.bak-*
*.orig-backup

# Hero clips, if they are ever added. Large binaries do not belong in git.
site/assets/*.mp4
site/assets/*.webm

# Local scratch
*.log
.claude/settings.local.json

# OS noise
Thumbs.db
desktop.ini
.DS_Store
